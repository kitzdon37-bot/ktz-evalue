# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# --- Base de données (Supabase, nouveau projet KTZ Évalue) ---
# Connexion mutualisée « Transaction pooler » (port 6543), utilisée par le site.
# Ajoutez ?pgbouncer=true à la fin de l'adresse.
DATABASE_URL=
# Connexion « Session pooler » (port 5432), utilisée pour créer les tables (migrations).
DIRECT_URL=

# --- Adresse du site ---
# En local : http://localhost:3000 ; en production : l'adresse publique du site.
APP_URL=

# --- Connexion avec Google (facultatif) ---
# Sans ces deux valeurs, le bouton « Continuer avec Google » est masqué.
# À créer sur https://console.cloud.google.com/apis/credentials (ID client OAuth, type « Application Web »).
# URI de redirection autorisée : <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails (Resend) ---
# Facultatif en local : sans clé, les emails s'affichent dans le terminal.
RESEND_API_KEY=
# Expéditeur, par exemple : KTZ Évalue <noreply@votre-domaine.com>
EMAIL_FROM=

# --- IA (génération des tests) ---
# Clé d'API Anthropic. Sans clé, les tests se créent à partir des modèles ou à la main.
ANTHROPIC_API_KEY=
# Plafond mensuel global de dépense IA, en dollars (50 par défaut). Ne concerne que Claude (payant).
AI_GLOBAL_MONTHLY_CAP_USD=

# IA gratuites de secours, essayées après Claude, UNIQUEMENT pour rédiger les questions
# (jamais pour les réponses des candidats : leurs formules gratuites peuvent réutiliser les données).
# Clé Mistral : https://console.mistral.ai — Clé Groq : https://console.groq.com
MISTRAL_API_KEY=
GROQ_API_KEY=
# Modèles (facultatif) : mistral-large-latest et openai/gpt-oss-120b par défaut.
MISTRAL_MODEL=
GROQ_MODEL=

# Compte de démonstration (base locale uniquement, créé par npm run demo:account)
DEMO_EMAIL=
DEMO_PASSWORD=

# --- WhatsApp (WasenderAPI) ---
# Facultatif en local : sans clé, les messages WhatsApp s'affichent dans le terminal.
WASENDER_API_KEY=

# --- Tâches planifiées (cron Vercel) ---
# Mot de passe aléatoire qui protège /api/cron/* (Vercel l'envoie automatiquement).
CRON_SECRET=
