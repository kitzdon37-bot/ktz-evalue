# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# --- Base de données (Supabase, nouveau projet KTZ Évalue) ---
# Connexion mutualisée « Transaction pooler » (port 6543), utilisée par le site.
# Ajoutez ?pgbouncer=true à la fin de l'adresse.
DATABASE_URL=
# Connexion « Session pooler » (port 5432), utilisée pour créer les tables (migrations).
DIRECT_URL=

# --- Adresse du site ---
# En local : http://localhost:3000 ; en production : l'adresse publique du site.
APP_URL=

# --- Emails (Resend) ---
# Facultatif en local : sans clé, les emails s'affichent dans le terminal.
RESEND_API_KEY=
# Expéditeur, par exemple : KTZ Évalue <noreply@votre-domaine.com>
EMAIL_FROM=

# --- IA (génération des tests) ---
# Clé d'API Anthropic. Sans clé, les tests se créent à partir des modèles ou à la main.
ANTHROPIC_API_KEY=
# Plafond mensuel global de dépense IA, en dollars (50 par défaut).
AI_GLOBAL_MONTHLY_CAP_USD=

# Compte de démonstration (base locale uniquement, créé par npm run demo:account)
DEMO_EMAIL=
DEMO_PASSWORD=
